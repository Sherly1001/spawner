{
  "manifest_version": 2,
  "name": "Spawner",
  "short_name": "Spawner",
  "version": "0.1.0",
  "description": "Simple multi-session browsing. Run multiple logins per site in normal tabs.",
  "minimum_chrome_version": "60",
  "browser_specific_settings": {
    "gecko": {
      "id": "spawner@local",
      "strict_min_version": "60.0"
    }
  },
  "permissions": [
    "tabs",
    "activeTab",
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "storage",
    "unlimitedStorage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["dist/background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "dist/index.html",
    "default_title": "Spawner"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/virtual-session.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": ["src/content/helper.js"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
